-
  const diffNames = ["SP Beginner", "SP Normal", "SP Hyper", "SP Another", "SP Leggendaria", "DP Normal", "DP Hyper", "DP Another", "DP Leggendaria"];
  
  const getLamp = (val) => {
    if (val === 7) return "FULL COMBO";
    if (val === 6) return "EX-HARD";
    if (val === 5) return "HARD CLEAR";
    if (val === 4) return "CLEAR";
    if (val === 3) return "EASY CLEAR";
    if (val === 2) return "ASSIST CLEAR";
    if (val === 1) return "FAILED";
    return "NO PLAY";
  };

div
  .card
    .card-header(style="display: flex; justify-content: space-between; align-items: center; padding-right: 1rem;")
      p.card-header-title
        span.icon
          i.mdi.mdi-format-list-bulleted
        | Score List
      .field.is-grouped
        .control
          .select.is-small
            select(id="score-sort-filter")
              option(value="recent") Recently Played
              option(value="mid") Music ID
              option(value="title") Music Title
              option(value="lamp") Clear Lamp
        .control
          .select.is-small
            select(id="score-page-size")
              option(value="10" selected) 10 per page
              option(value="30") 30 per page
              option(value="50") 50 per page
    .card-content
      table.table.is-striped.is-fullwidth.is-hoverable
        thead
          tr    
            th Music Title
            th Difficulty
            th Clear Lamp
            th EX Score
            th BP
        tbody#score-table-body
          each i in score
            - for (let d = 0; d < 9; d++) {
              - let lamp = i.cArray[d];
              - let ex = i.esArray[d];
              - let miss = i.mArray[d];
              
              - if (lamp > 0 || ex > 0 || miss > -1) {
                - const updateTime = Array.isArray(i.playTimeArray) && Number(i.playTimeArray[d]) > 0 ? Number(i.playTimeArray[d]) : 0;
                tr(data-mid=i.mid data-updated=updateTime data-lamp=lamp data-ex=ex)
                  //- A space for the title instead of the ID
                  td.music-title(data-mid=i.mid) 
                    strong #{i.mid}
                  td
                    span.tag.is-info.is-light #{diffNames[d]}
                  td 
                    strong #{getLamp(lamp)}
                  td #{ex}
                  td #{miss === -1 ? 0 : miss}
              - }
            - }

      nav.pagination.is-small.is-centered(
        role="navigation"
        aria-label="pagination"
        style="margin-top: 1rem;"
      )
        button#score-page-prev.button.is-small(
          type="button"
          disabled
        ) Previous
        span#score-page-info(
          style="display: flex; align-items: center; padding: 0 1rem;"
        ) Page 1 / 1
        button#score-page-next.button.is-small(
          type="button"
          disabled
        ) Next

//- 3. run Title Replacement
script.
  $(document).ready(function() {
    let currentScorePage = 1;
    let scorePageSize = 10;
    // Cache music title text attributes for each row
    $('tbody tr').each(function() {
      const mid = String($(this).data('mid'));
      const title = (window.musicDB && window.musicDB[mid]) ? window.musicDB[mid] : mid;
      $(this).attr('data-title', title);
    });

        function renderScorePage() {
      const $rows = $('#score-table-body').find('tr');
      const totalRows = $rows.length;
      const totalPages = Math.max(1, Math.ceil(totalRows / scorePageSize));

      if (currentScorePage > totalPages) {
        currentScorePage = totalPages;
      }

      if (currentScorePage < 1) {
        currentScorePage = 1;
      }

      const startIndex = (currentScorePage - 1) * scorePageSize;
      const endIndex = startIndex + scorePageSize;

      $rows.hide();
      $rows.slice(startIndex, endIndex).show();

      $('#score-page-info').text(
        'Page ' + currentScorePage + ' / ' + totalPages
      );

      $('#score-page-prev').prop(
        'disabled',
        currentScorePage <= 1
      );

      $('#score-page-next').prop(
        'disabled',
        currentScorePage >= totalPages
      );
    }

    // Define sorting function
    function sortScoreTable(sortType) {
      const $tbody = $('#score-table-body');
      const $rows = $tbody.find('tr').get();

      $rows.sort(function(a, b) {
        const midA = Number($(a).data('mid')) || 0;
        const midB = Number($(b).data('mid')) || 0;
        const updatedA = Number($(a).data('updated')) || 0;
        const updatedB = Number($(b).data('updated')) || 0;
        const lampA = Number($(a).data('lamp')) || 0;
        const lampB = Number($(b).data('lamp')) || 0;
        const exA = Number($(a).data('ex')) || 0;
        const exB = Number($(b).data('ex')) || 0;
        const titleA = $(a).attr('data-title') || '';
        const titleB = $(b).attr('data-title') || '';

        switch (sortType) {
          case 'recent': // Recently Played (most recent first / descending)
            return updatedB - updatedA || midA - midB;
          case 'mid': // Music ID (ascending)
            return midA - midB;
          case 'title': // Music Title (alphabetical / A-Z)
            return titleA.localeCompare(titleB);
          case 'lamp': // Clear Lamp (higher lamp first -> tie-breaker: higher EX score)
            if (lampB !== lampA) return lampB - lampA;
            return exB - exA;
          default:
            return 0;
        }
      });

      $.each($rows, function(index, row) {
        $tbody.append(row);
      });

      renderScorePage();
    }

    // Execute default sort (Recently Played) and bind change event
    sortScoreTable($('#score-sort-filter').val());
    $('#score-sort-filter').on('change', function() {
      currentScorePage = 1;
      sortScoreTable($(this).val());
    });
        $('#score-page-size').on('change', function() {
      scorePageSize = Number($(this).val()) || 10;
      currentScorePage = 1;
      renderScorePage();
    });

    $('#score-page-prev').on('click', function() {
      if (currentScorePage <= 1) return;

      currentScorePage -= 1;
      renderScorePage();
    });

    $('#score-page-next').on('click', function() {
      const totalRows = $('#score-table-body').find('tr').length;
      const totalPages = Math.max(
        1,
        Math.ceil(totalRows / scorePageSize)
      );

      if (currentScorePage >= totalPages) return;

      currentScorePage += 1;
      renderScorePage();
    });
    
    $('.music-title').each(function() {
      const $cell = $(this);
      const mid = String($cell.data('mid'));
      
      if (window.musicDB && window.musicDB[mid]) {
        $cell.find('strong').text(window.musicDB[mid]);
      }
    });
  });