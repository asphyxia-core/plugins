        const infoForVersion = info.find(i => i.version === version)
        const profilesForVersion = profile
          .filter(p => p.version === version)
          .sort((a, b) => gameOrder.indexOf(a.game) - gameOrder.indexOf(b.game))

      if infoForVersion
        +userCard(infoForVersion)
        +boardCard(infoForVersion)

      each pr in profilesForVersion
        +profileCard(pr)
        +rivalCard(pr)

style.
  /* Profile view shows everything except the board editor; board view shows only the editor. */
  .board-card { display: none; }
  .playerboard-fullscreen .board-card { display: block; }
  .playerboard-fullscreen .version-tabs,
  .playerboard-fullscreen .user-card,
  .playerboard-fullscreen .profile-card,
  .playerboard-fullscreen .rival-card { display: none; }

  .pb-editor {
    display: flex; flex-wrap: wrap; gap: 1.25rem; justify-content: center; align-items: flex-start;
    padding: 1rem 0; outline: none;
  }
  .pb-col { display: flex; flex-direction: column; gap: .5rem; }
  .pb-left, .pb-right { flex: 1 1 200px; max-width: 260px; }
  .pb-center { flex: 0 1 360px; }
  .pb-heading {
    background: #111; color: #fff; text-align: center; font-weight: 600;
    padding: .3rem .5rem; margin-top: .35rem; border-radius: 2px; letter-spacing: .03em;
  }
  .pb-slots { display: flex; flex-direction: column; gap: .35rem; }
  .pb-slot {
    display: flex; align-items: center; gap: .5rem; width: 100%; min-height: 2.6rem;
    padding: .3rem .5rem; border: 2px solid #dbdbdb; border-radius: 3px;
    background: #fff; color: #333; text-align: left; cursor: pointer; font-size: .8rem; line-height: 1.2;
  }
  .pb-slot:hover { background: #f0f0f0; }
  .pb-slot.is-empty { color: #999; }
  .pb-slot.is-selected { border-color: #ffd600; background: #e8e8e8; box-shadow: 0 0 0 2px rgba(255,214,0,.35); }
  .pb-slot-no { flex: 0 0 auto; min-width: 1.6rem; font-weight: 700; color: #6b4fd8; }
  .pb-slot-name { flex: 1 1 auto; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  .pb-board { width: 100%; max-width: 360px; margin: 0 auto; background: #000; border: 1px solid #555; }
  .pb-header { display: flex; gap: 4px; padding: 6px; background: #000; }
  .pb-nameplate { flex: 1 1 auto; border: 1px solid #888; padding: 2px 6px; min-width: 0; }
  .pb-title { font-size: .7rem; color: #ddd; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pb-name { font-size: .95rem; font-weight: 700; color: #ff4d4d; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pb-skill { flex: 0 0 64px; border: 1px solid #888; color: #aaa; font-size: .7rem; padding: 2px 6px; }
  .pb-area {
    position: relative; width: 100%; aspect-ratio: 320 / 470; overflow: hidden; touch-action: none;
    background: linear-gradient(135deg, #20243a, #384d69);
  }
  .pb-area.has-sheet { background: linear-gradient(135deg, #3a3f62, #6a7fa3); }
  .pb-sheet-label {
    position: absolute; inset: 4px 0 auto 0; text-align: center; font-size: .7rem;
    color: rgba(255,255,255,.55); pointer-events: none;
  }
  .pb-cell {
    position: absolute; width: 8px; height: 8px; border-radius: 50%;
    background: rgba(255,255,255,.28); transform: translate(-50%, -50%); pointer-events: none;
  }
  .pb-cell.is-target { background: #ffd600; width: 12px; height: 12px; }
  .pb-sticker {
    position: absolute; display: flex; align-items: center; justify-content: center;
    padding: 2px; border: 1px solid rgba(255,255,255,.7); border-radius: 4px;
    background: rgba(0,0,0,.72); color: #fff; font-size: .62rem; line-height: 1.1; text-align: center;
    overflow: hidden; cursor: grab; user-select: none; transform-origin: center;
  }
  .pb-sticker.is-selected { border: 2px solid #ffd600; box-shadow: 0 0 8px rgba(255,214,0,.7); z-index: 20; }
  .pb-sticker.is-dragging { cursor: grabbing; opacity: .85; z-index: 30; }

  .pb-picker { display: flex; flex-direction: column; gap: .35rem; }
  .pb-dpad {
    display: grid; grid-template-columns: repeat(3, 3rem); grid-template-rows: repeat(3, 3rem);
    gap: .35rem; justify-content: center;
  }
  .pb-up { grid-column: 2; grid-row: 1; }
  .pb-left-btn { grid-column: 1; grid-row: 2; }
  .pb-right-btn { grid-column: 3; grid-row: 2; }
  .pb-down { grid-column: 2; grid-row: 3; }
  .pb-row { display: flex; gap: .6rem; justify-content: center; }
  .pb-btn {
    width: 3rem; height: 3rem; display: inline-flex; align-items: center; justify-content: center;
    background: #fff; color: #111; border: 3px solid #111; border-radius: 2px;
    box-shadow: 2px 2px 0 rgba(0,0,0,.45); font-size: 1.6rem; cursor: pointer;
  }
  .pb-btn:hover:not(:disabled) { background: #f3f3f3; }
  .pb-btn:active:not(:disabled) { transform: translate(1px, 1px); box-shadow: 1px 1px 0 rgba(0,0,0,.45); }
  .pb-btn:disabled { opacity: .35; cursor: default; }
  .pb-btn.is-current { background: #ffd600; }
  .pb-save {
    margin-top: .9rem; align-self: center; width: 9rem; height: 3.4rem;
    background: #ffe600; color: #555; border: 3px solid #111; border-radius: 2px;
    font-size: 1.15rem; font-weight: 700; cursor: pointer; box-shadow: 2px 2px 0 rgba(0,0,0,.45);
  }
  .pb-save:hover { background: #fff04d; }
  .pb-status { text-align: center; min-height: 1.2em; }

script.
  (() => {
    // Page mode: ?version=<v> opens that version tab; adding &view=playerboard
    // switches to the playerboard editor for that version.
    const params = new URLSearchParams(location.search);
    const selectedVersion = params.get('version');
    if (selectedVersion) {
      const tab = document.querySelector('li[tab-group="profile-version"][data-version="' + CSS.escape(selectedVersion) + '"]');
      if (tab) {
        const index = tab.getAttribute('tab-index');
        document.querySelectorAll('[tab-group="profile-version"]').forEach(el => {
          el.classList.toggle('is-active', el.getAttribute('tab-index') === index);
        });
      }
    }
    if (params.get('view') === 'playerboard') document.body.classList.add('playerboard-fullscreen');
  })();

script.
