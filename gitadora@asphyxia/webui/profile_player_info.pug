-
  function getFullGameName(shortName) {
    switch (shortName) {
      case "gf":
        return "GuitarFreaks"
      case "dm" :
        return "DrumMania"
      default:
        return "Unknown"
    }
  }
  function getFullGameVersion(shortVer) {
    switch (shortVer) {
      case "re" :
        return "Tri-Boost Re:EVOLVE"
      case "matixx":
        return "Matixx"
      case "exchain":
        return "EXCHAIN"
      case "nextage":
        return "NEX+AGE"
      case "highvoltage":
        return "HIGH-VOLTAGE"
      case "fuzzup":
        return "FUZZ-UP"
      case "galaxywave":
        return "GALAXY WAVE"
      case "galaxywave_delta":
        return "GALAXY WAVE DELTA"
      default:
        return "Unknown"
    }
  }

  const versionOrder = ["re", "matixx", "exchain", "nextage", "highvoltage", "fuzzup", "galaxywave", "galaxywave_delta"]
  const gameOrder = ["gf", "dm"]

  // Versions that have either a playerinfo or a profile document, in canonical order.
  function getVersionsPresent(info, profile) {
    const present = new Set()
    for (const i of info) present.add(i.version)
    for (const p of profile) present.add(p.version)
    return versionOrder.filter(v => present.has(v))
  }

  // ---- Playerboard: mirrors models/playerboard.ts (fixed 3x5 grid, two sizes). ----
  const PB = { CENTER_X: 160, CENTER_Y: 235, STEP: 96, SLOTS: 10, ROTATE_STEP: 45 }
  const PB_COLUMNS = [PB.CENTER_X - PB.STEP, PB.CENTER_X, PB.CENTER_X + PB.STEP]
  const PB_ROWS = [-2, -1, 0, 1, 2].map(n => PB.CENTER_Y + n * PB.STEP)
  const catalogById = new Map((trbitems || []).map(item => [item.id, item]))
  const sheetItems = (trbitems || []).filter(item => item.category === 'Sheet')
  const stickerCatalog = (trbitems || []).filter(item => item.category !== 'Sheet').map(item => [item.id, item.name, item.category])

  function closestIndex(value, options) {
    return options.reduce((best, option, idx) => Math.abs(option - value) < Math.abs(options[best] - value) ? idx : best, 0)
  }

  // Turns any stored board shape into the editor's grid presets:
  //  - current editor: playerboard.sheet + playerboard.sticker (with slot)
  //  - older free-placement editor: playerboard.sticker, background first
  //  - legacy: sheet + card
  // Off-grid coordinates snap to the nearest grid cell / size.
  function toPickerBoard(i) {
    const pb = i && i.playerboard
    let sheet = null
    let list = []
    if (pb && Array.isArray(pb.sticker)) {
      list = pb.sticker
      if (Object.prototype.hasOwnProperty.call(pb, 'sheet')) {
        sheet = pb.sheet == null ? null : Number(pb.sheet)
      } else if (list.length && (catalogById.get(Number(list[0].id)) || {}).category === 'Sheet') {
        sheet = Number(list[0].id)
        list = list.slice(1)
      }
    } else {
      sheet = i && i.sheet != null ? Number(i.sheet) : null
      list = Array.isArray(i && i.card) ? i.card : []
    }

    const num = (value, fallback) => Number.isFinite(Number(value)) ? Number(value) : fallback
    const used = new Set()
    const stickers = []
    list.forEach((item, index) => {
      if (!item || !Number.isFinite(Number(item.id))) return
      const x = num(item.pos_x !== undefined ? item.pos_x : (item.position || [])[0], PB.CENTER_X)
      const y = num(item.pos_y !== undefined ? item.pos_y : (item.position || [])[1], PB.CENTER_Y)
      const scale = num(item.scale_x !== undefined ? item.scale_x : (item.scale || [])[0], 1)
      const rotate = num(item.rotate !== undefined ? item.rotate : item.rotation, 0)
      let slot = Number.isInteger(item.slot) ? item.slot : index
      if (slot < 0 || slot >= PB.SLOTS || used.has(slot)) {
        slot = [...Array(PB.SLOTS).keys()].find(s => !used.has(s))
      }
      if (slot === undefined) return
      used.add(slot)
      const snapped = Math.round(rotate / PB.ROTATE_STEP) * PB.ROTATE_STEP
      stickers.push({
        id: Math.trunc(Number(item.id)),
        position: closestIndex(y, PB_ROWS) * 3 + closestIndex(x, PB_COLUMNS) + 1,
        size: scale < 0.8 ? 2 : 1,
        rotate: ((snapped % 360) + 360) % 360,
        slot
      })
    })
    return { sheet, stickers }
  }
