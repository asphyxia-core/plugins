script.
  (() => {
    // Must match models/playerboard.ts.
    const BOARD_W = 320, BOARD_H = 470;
    const CENTER_X = 160, CENTER_Y = 235, STEP = 96;
    const COLUMNS = 3, ROWS = 5, SLOTS = 10, ROTATE_STEP = 45;
    const SIZE_SCALE = { 1: 1, 2: 0.6 };
    const CATEGORY_ORDER = ['Sticker', 'Seasonal', 'Special'];

    const catalog = window.GITADORA_STICKER_CATALOG || [];
    const byId = new Map(catalog.map(entry => [entry[0], entry]));
    const byCategory = new Map();
    for (const entry of catalog) {
      if (!byCategory.has(entry[2])) byCategory.set(entry[2], []);
      byCategory.get(entry[2]).push(entry);
    }
    const categories = CATEGORY_ORDER.filter(c => byCategory.has(c))
      .concat([...byCategory.keys()].filter(c => !CATEGORY_ORDER.includes(c)));

    const positionToXY = position => {
      const row = Math.floor((position - 1) / COLUMNS);
      const col = (position - 1) % COLUMNS;
      return [CENTER_X + (col - 1) * STEP, CENTER_Y + (row - 2) * STEP];
    };
    const xyToPosition = (x, y) => {
      const col = Math.max(0, Math.min(COLUMNS - 1, Math.round((x - CENTER_X) / STEP) + 1));
      const row = Math.max(0, Math.min(ROWS - 1, Math.round((y - CENTER_Y) / STEP) + 2));
      return row * COLUMNS + col + 1;
    };
    const stickerName = id => {
      const entry = byId.get(id);
      return entry ? entry[1] : 'Unknown #' + id;
    };

    const initialize = editor => {
      const form = editor.closest('form');
      const jsonField = form.querySelector('[data-pb-json]');
      const sheetSelect = editor.querySelector('[data-pb-sheet]');
      const slotList = editor.querySelector('[data-pb-slots]');
      const area = editor.querySelector('[data-pb-area]');
      const categorySelect = editor.querySelector('[data-pb-category]');
      const filterInput = editor.querySelector('[data-pb-filter]');
      const itemSelect = editor.querySelector('[data-pb-item]');
      const selectedLabel = editor.querySelector('[data-pb-selected-label]');

      // ---- State ----
      let initial = {};
      try { initial = JSON.parse(jsonField.value || '{}'); } catch (_) { initial = {}; }
      const state = { sheet: initial.sheet == null ? null : Number(initial.sheet), slots: Array(SLOTS).fill(null), selected: 0 };
      (Array.isArray(initial.stickers) ? initial.stickers : []).forEach(item => {
        if (item && Number.isInteger(item.slot) && item.slot >= 0 && item.slot < SLOTS) {
          state.slots[item.slot] = { id: item.id, position: item.position || 8, size: item.size || 1, rotate: item.rotate || 0 };
        }
      });

      if (state.sheet != null && !sheetSelect.querySelector('option[value="' + state.sheet + '"]')) {
        sheetSelect.insertAdjacentHTML('beforeend', '<option value="' + state.sheet + '">Unknown #' + state.sheet + '</option>');
      }
      sheetSelect.value = state.sheet == null ? '' : String(state.sheet);

      const current = () => state.slots[state.selected];
      const sync = () => {
        jsonField.value = JSON.stringify({
          sheet: state.sheet,
          stickers: state.slots
            .map((s, slot) => s && { id: s.id, position: s.position, size: s.size, rotate: s.rotate, slot })
            .filter(Boolean)
        });
      };

      // ---- Static preview grid ----
      const sheetLabel = document.createElement('div');
      sheetLabel.className = 'pb-sheet-label';
      area.appendChild(sheetLabel);
      const cells = [];
      for (let position = 1; position <= COLUMNS * ROWS; position++) {
        const [x, y] = positionToXY(position);
        const cell = document.createElement('div');
        cell.className = 'pb-cell';
        cell.style.left = (x / BOARD_W * 100) + '%';
        cell.style.top = (y / BOARD_H * 100) + '%';
        area.appendChild(cell);
        cells.push(cell);
      }

      // ---- Slot list ----
      const slotButtons = [];
      for (let slot = 0; slot < SLOTS; slot++) {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'pb-slot';
        button.innerHTML = '<span class="pb-slot-no"></span><span class="pb-slot-name"></span>';
        button.querySelector('.pb-slot-no').textContent = slot + 1;
        button.addEventListener('click', () => { state.selected = slot; render(); });
        slotList.appendChild(button);
        slotButtons.push(button);
      }

      // ---- Sticker picker ----
      const fillCategories = () => {
        categorySelect.innerHTML = '';
        categories.forEach(c => {
          const option = document.createElement('option');
          option.value = c;
          option.textContent = c + ' (' + byCategory.get(c).length + ')';
          categorySelect.appendChild(option);
        });
      };
      const fillItems = selectedId => {
        const query = filterInput.value.trim().toLowerCase();
        const items = (byCategory.get(categorySelect.value) || [])
          .filter(entry => !query || entry[1].toLowerCase().includes(query) || String(entry[0]) === query);
        itemSelect.innerHTML = '';
        const placeholder = document.createElement('option');
        placeholder.value = '';
        placeholder.textContent = current() ? '— keep current —' : '— choose a sticker —';
        itemSelect.appendChild(placeholder);
        items.forEach(entry => {
          const option = document.createElement('option');
          option.value = entry[0];
          option.textContent = entry[1];
          itemSelect.appendChild(option);
        });
        itemSelect.value = selectedId != null && items.some(e => e[0] === selectedId) ? String(selectedId) : '';
      };
      const syncPicker = () => {
        const sticker = current();
        const entry = sticker && byId.get(sticker.id);
        if (entry) categorySelect.value = entry[2];
        filterInput.value = '';
        fillItems(sticker ? sticker.id : null);
      };
      fillCategories();

      // ---- Rendering ----
      const placeSticker = (el, sticker, x, y) => {
        const scale = SIZE_SCALE[sticker.size] || 1;
        el.style.left = (x / BOARD_W * 100) + '%';
        el.style.top = (y / BOARD_H * 100) + '%';
        el.style.width = (STEP * scale / BOARD_W * 100) + '%';
        el.style.height = (STEP * scale / BOARD_H * 100) + '%';
        el.style.transform = 'translate(-50%, -50%) rotate(' + sticker.rotate + 'deg)';
      };

      const render = () => {
        const selected = current();

        area.classList.toggle('has-sheet', state.sheet != null);
        sheetLabel.textContent = state.sheet != null ? 'Sheet: ' + (sheetSelect.selectedOptions[0] || {}).textContent : '';
        cells.forEach((cell, index) => cell.classList.toggle('is-target', !!selected && selected.position === index + 1));

        area.querySelectorAll('.pb-sticker').forEach(el => el.remove());
        state.slots.forEach((sticker, slot) => {
          if (!sticker) return;
          const el = document.createElement('div');
          el.className = 'pb-sticker' + (slot === state.selected ? ' is-selected' : '');
          el.textContent = stickerName(sticker.id);
          el.title = 'Slot ' + (slot + 1) + ': ' + stickerName(sticker.id) + ' — drag to move';
          el.style.zIndex = slot + 1;
          placeSticker(el, sticker, ...positionToXY(sticker.position));
          bindDrag(el, slot);
          area.appendChild(el);
        });

        slotButtons.forEach((button, slot) => {
          const sticker = state.slots[slot];
          button.classList.toggle('is-selected', slot === state.selected);
          button.classList.toggle('is-empty', !sticker);
          button.querySelector('.pb-slot-name').textContent = sticker ? stickerName(sticker.id) : '(empty)';
        });

        selectedLabel.textContent = 'Sticker — slot ' + (state.selected + 1);
        const has = !!selected;
        editor.querySelectorAll('[data-pb-action]').forEach(button => { button.disabled = !has; });
        if (has) {
          const row = Math.floor((selected.position - 1) / COLUMNS), col = (selected.position - 1) % COLUMNS;
          editor.querySelector('[data-pb-action="up"]').disabled = row === 0;
          editor.querySelector('[data-pb-action="down"]').disabled = row === ROWS - 1;
          editor.querySelector('[data-pb-action="left"]').disabled = col === 0;
          editor.querySelector('[data-pb-action="right"]').disabled = col === COLUMNS - 1;
          editor.querySelector('[data-pb-action="layer-up"]').disabled = state.selected === 0;
          editor.querySelector('[data-pb-action="layer-down"]').disabled = state.selected === SLOTS - 1;
        }
        editor.querySelector('[data-pb-action="size-small"]').classList.toggle('is-current', has && selected.size === 2);
        editor.querySelector('[data-pb-action="size-normal"]').classList.toggle('is-current', has && selected.size === 1);

        syncPicker();
        sync();
      };

      // Free drag for feedback, snapped to the nearest grid cell on release.
      const bindDrag = (el, slot) => {
        let drag = null;
        el.addEventListener('pointerdown', event => {
          event.preventDefault();
          editor.focus({ preventScroll: true });
          el.setPointerCapture(event.pointerId);
          drag = { rect: area.getBoundingClientRect(), moved: false };
          if (state.selected !== slot) {
            state.selected = slot;
            slotButtons.forEach((b, i) => b.classList.toggle('is-selected', i === slot));
            area.querySelectorAll('.pb-sticker').forEach(s => s.classList.remove('is-selected'));
            el.classList.add('is-selected');
          }
        });
        el.addEventListener('pointermove', event => {
          if (!drag) return;
          drag.moved = true;
          el.classList.add('is-dragging');
          const x = Math.max(0, Math.min(BOARD_W, (event.clientX - drag.rect.left) / drag.rect.width * BOARD_W));
          const y = Math.max(0, Math.min(BOARD_H, (event.clientY - drag.rect.top) / drag.rect.height * BOARD_H));
          drag.position = xyToPosition(x, y);
          placeSticker(el, state.slots[slot], x, y);
          cells.forEach((cell, index) => cell.classList.toggle('is-target', drag.position === index + 1));
        });
        const end = event => {
          if (!drag) return;
          try { el.releasePointerCapture(event.pointerId); } catch (_) {}
          if (drag.moved && drag.position) state.slots[slot].position = drag.position;
          drag = null;
          render();
        };
        el.addEventListener('pointerup', end);
        el.addEventListener('pointercancel', end);
      };

      // ---- Actions ----
      const move = (dRow, dCol) => {
        const s = current();
        if (!s) return;
        const row = Math.floor((s.position - 1) / COLUMNS) + dRow;
        const col = (s.position - 1) % COLUMNS + dCol;
        if (row < 0 || row >= ROWS || col < 0 || col >= COLUMNS) return;
        s.position = row * COLUMNS + col + 1;
      };
      const actions = {
        'up': () => move(-1, 0),
        'down': () => move(1, 0),
        'left': () => move(0, -1),
        'right': () => move(0, 1),
        'rotate-ccw': () => { current().rotate = (current().rotate - ROTATE_STEP + 360) % 360; },
        'rotate-cw': () => { current().rotate = (current().rotate + ROTATE_STEP) % 360; },
        'size-small': () => { current().size = 2; },
        'size-normal': () => { current().size = 1; },
        'remove': () => { state.slots[state.selected] = null; },
        'layer-up': () => swap(state.selected, state.selected - 1),
        'layer-down': () => swap(state.selected, state.selected + 1),
      };
      const swap = (a, b) => {
        if (b < 0 || b >= SLOTS) return;
        [state.slots[a], state.slots[b]] = [state.slots[b], state.slots[a]];
        state.selected = b;
      };
      editor.addEventListener('click', event => {
        const button = event.target.closest('[data-pb-action]');
        if (!button || button.disabled) return;
        if (!current() && button.dataset.pbAction !== 'remove') return;
        actions[button.dataset.pbAction]();
        render();
      });
      editor.addEventListener('keydown', event => {
        if (event.target.matches('input, select, textarea')) return;
        const key = { ArrowUp: 'up', ArrowDown: 'down', ArrowLeft: 'left', ArrowRight: 'right', Delete: 'remove' }[event.key];
        if (!key || !current()) return;
        event.preventDefault();
        actions[key]();
        render();
      });

      sheetSelect.addEventListener('change', () => {
        state.sheet = sheetSelect.value === '' ? null : Number(sheetSelect.value);
        render();
      });
      categorySelect.addEventListener('change', () => { filterInput.value = ''; fillItems(current() ? current().id : null); });
      filterInput.addEventListener('input', () => fillItems(current() ? current().id : null));
      itemSelect.addEventListener('change', () => {
        if (itemSelect.value === '') return;
        const id = Number(itemSelect.value);
        if (current()) current().id = id;
        else state.slots[state.selected] = { id, position: 8, size: 1, rotate: 0 };
        render();
      });
      // Registered before ajax-form.js binds its handler, so the JSON is current when sent.
      form.addEventListener('submit', sync);

      const firstUsed = state.slots.findIndex(Boolean);
      state.selected = firstUsed >= 0 ? firstUsed : 0;
      render();
    };

    document.querySelectorAll('[data-pb-editor]').forEach(initialize);
  })();
